# 업스테이지 API 키를 아래에 입력하세요
UPSTAGE_API_KEY=your_api_key_here

# MCP server credentials (fill as needed)
BRAVE_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Open Router api
OPNEROUTER_API_KEY=
N8N_API_URL=
N8N_API_KEY=
POSTGRES_URL=

# 문서 전처리 모델 설정
# 사용 가능한 옵션: local, openai, google, anthropic
PREPROCESSING_MODEL=local
# 전처리 모델 설정 (API 모델 사용 시)
PREPROCESSING_MAX_TOKENS=2000
PREPROCESSING_TEMPERATURE=0.3

# 이미지 분석/추출(지능형) 프로바이더 설정: local | openrouter
# 기본값은 openrouter (config.py) — 필요시 local로 변경 가능
IMAGE_ANALYSIS_PROVIDER=openrouter
# OpenRouter 실패 시 폴백(로컬 서버/로컬 모델) 비활성화. true로 설정하면 실패 즉시 에러 발생
DISABLE_IMAGE_FALLBACK=false

# OpenRouter 설정 (주의: API 키 환경변수명은 프로젝트 사양상 오타 포함 — OPNEROUTER_API_KEY)
# 대체: OPENROUTER_API_BASE, OPENROUTER_MM_MODEL
OPNEROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api
# 데이터 전처리 이미지 분석 기본 모델
OPENROUTER_MM_MODEL=z-ai/glm-4.5v

# 멀티모달 모델 확장(콤마로 여러 개)
# OpenAI 예시: gpt-5-mini,gpt-5-nano
EXTRA_MULTIMODAL_OPENAI_MODELS=
# Google 예시: gemini-2.5-pro
EXTRA_MULTIMODAL_GOOGLE_MODELS=
# Anthropic 예시: claude-opus-4-1-20250805
EXTRA_MULTIMODAL_ANTHROPIC_MODELS=
#+ OpenRouter 예시: z-ai/glm-4.5v, qwen/qwen2.5-vl-32b-instruct
EXTRA_MULTIMODAL_OPENROUTER_MODELS=
