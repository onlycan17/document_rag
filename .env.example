# 업스테이지 임베딩 API 키 (필수 - 벡터 임베딩용)
UPSTAGE_API_KEY=your_api_key_here

# MCP server credentials (fill as needed)
BRAVE_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
N8N_API_URL=
N8N_API_KEY=
POSTGRES_URL=

# ===== LLM 제공자 (외부 API만 지원) =====
# 기본값: openrouter. 선택지: openai, google, anthropic, openrouter
LLM_PROVIDER=openrouter

# OpenRouter API 키 (권장 표기: OPENROUTER_API_KEY / 하위 호환: OPNEROUTER_API_KEY 모두 인식)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api
# 텍스트 처리 기본 모델
OPENROUTER_MODEL=z-ai/glm-4.5-air
# 이미지/멀티모달 분석 기본 모델
OPENROUTER_MM_MODEL=z-ai/glm-4.5v

# OpenAI / Google / Anthropic 키 (해당 제공자 사용 시)
OPENAI_API_KEY=

# ===== 문서 전처리 =====
# 사용 가능한 옵션: openai, google, anthropic, openrouter (로컬 모델 미지원)
PREPROCESSING_MODEL=openrouter
PREPROCESSING_MAX_TOKENS=2000
PREPROCESSING_TEMPERATURE=1.0

# 이미지 분석 프로바이더: openai | google | anthropic | openrouter
IMAGE_ANALYSIS_PROVIDER=openrouter

# MD 후처리 전용 오버라이드 (선택)
MD_POSTPROCESS_PROVIDER=
MD_POSTPROCESS_MODEL=

# 멀티모달 모델 확장(콤마로 여러 개)
EXTRA_MULTIMODAL_OPENAI_MODELS=
EXTRA_MULTIMODAL_GOOGLE_MODELS=
EXTRA_MULTIMODAL_ANTHROPIC_MODELS=
EXTRA_MULTIMODAL_OPENROUTER_MODELS=

# ===== 하위 호환 오타 표기 (OPENROUTER_API_KEY 미설정 시에만 사용됨) =====
OPNEROUTER_API_KEY=

# ===== 벡터 DB / 임베딩 =====
VECTOR_DB_PATH=./vector_db
KOREAN_EMBEDDING_MODEL=jhgan/ko-sbert-multitask

# ===== 청킹 =====
CHUNK_SIZE=150
CHUNK_OVERLAP=50
USE_SEMANTIC_CHUNKING=false
MAX_CHUNK_SIZE=30000

# ===== 검색 =====
K_DOCUMENTS=12
USE_MMR_SEARCH=true
ENABLE_HYBRID_SEARCH=false
KEYWORD_SEARCH_WEIGHT=0.3
VECTOR_SEARCH_WEIGHT=0.7
ENABLE_QUERY_EXPANSION=true
ENABLE_QUERY_PREPROCESSING=true
ENABLE_RESULT_MERGING=true

# ===== 대용량 컨텍스트 처리 =====
ENABLE_LARGE_CONTEXT_PROCESSING=true
LARGE_CONTEXT_THRESHOLD=50000
PARALLEL_WORKERS=3
CHUNK_TIMEOUT=120.0

# ===== 스트리밍 답변 =====
ENABLE_STREAMING=true

# ===== MD 후처리 =====
ENABLE_MD_POSTPROCESSING=true
MD_POSTPROCESS_TARGET_QUALITY=90

# ===== 멀티모달 전처리 =====
ENABLE_MULTIMODAL_PREPROCESSING=true
MULTIMODAL_PREPROCESSING_PROVIDER=openrouter
MULTIMODAL_PREPROCESSING_MODEL=z-ai/glm-4.5v

# ===== 이미지 분석 =====
ENABLE_IMAGE_ENHANCEMENT=false
IMAGE_ENHANCEMENT_PROMPT=
LOCAL_IMAGE_RELEVANCE_THRESHOLD=0.6

# ===== API 호출 안정성 (재시도/백오프) =====
API_MAX_RETRIES=5
API_BASE_DELAY=3.0
API_MAX_DELAY=300.0

# ===== LangSmith 추적 (선택) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
